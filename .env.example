# ── Conviction Forge Worker — environment ────────────────────────────────────
# Copy to `.env` for local development. In production these are set as Railway
# service variables. NEVER commit a filled-in .env.

# Shared secret. The Conviction server sends `Authorization: Bearer <secret>`
# on every protected request; the worker rejects anything else with 401.
# Must be identical to Conviction's own FORGE_WORKER_SECRET.
FORGE_WORKER_SECRET=change-me-to-a-long-random-string

# OpenRouter API key. Used as OpenCode's model provider for Builder /
# Challenger / Escalation roles. Without it, the AI phases report
# "not configured" honestly rather than fabricating a plan or a diff.
OPENROUTER_API_KEY=

# GitHub token used to push the forge branch and open the pull request.
# Use a FINE-GRAINED token scoped ONLY to ioradsun/belief-compass with
# Contents: read/write and Pull requests: read/write. Never a broad classic token.
GITHUB_TOKEN=

# The repository the worker operates on.
REPO_FULL_NAME=ioradsun/belief-compass

# Optional: override the clone URL (mirror, GHE, or a local remote in tests).
# Pull requests are still opened against REPO_FULL_NAME on github.com.
# REPO_URL=https://github.com/ioradsun/belief-compass

# Base branch to fork from and target pull requests at.
BASE_BRANCH=main

# Where per-job workspaces live. On Railway, mount a Volume here.
WORKSPACE_ROOT=/workspace

# Port the HTTP server listens on. Railway injects PORT automatically.
PORT=8080

# Identity used for the merge/worktree commits the worker makes locally.
GIT_AUTHOR_NAME=Conviction Forge
GIT_AUTHOR_EMAIL=forge@conviction.company

# Optional: path/name of the OpenCode binary (default: opencode on PATH).
OPENCODE_BIN=opencode

# Optional: directory where gstack is installed inside the container.
GSTACK_DIR=/opt/gstack
